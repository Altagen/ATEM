# ATEM's configuration. Copy to .env and fill in the required values.
#
# With compose, this file supplies the variables compose.yaml passes to the
# containers. In development, the API reads it directly (see docs/development.md).
# Every setting is described in docs/deployment.md.
#
# **The tunables below are written out rather than commented.** compose.yaml
# names them as `${VAR:-default}`; Docker expands that, podman-compose does not
# and passes the text through verbatim — which reached ATEM 0.1.0 as a literal
# `${ATEM_TRUSTED_PROXIES:-10.89.42.0/24}` and put every visitor in one
# rate-limit bucket without a word. Spelled out here, both behave the same.

# ── Required ─────────────────────────────────────────────────────────────────

# The token signing key. There is no fallback value — generate one:
#   openssl rand -base64 32
JWT_SECRET=

# The instance's one administrator — no fallback either. The configuration is
# the truth: at every start the account is created or brought back to these
# values (a new password here ends the old one's sessions), and any other
# account holding the role loses it. The administrator only administers: it has
# no collection, is absent from the directory, and nobody can befriend it.
# The address must not belong to a player's account — the start is refused.
ATEM_ADMIN_EMAIL=
# 16 characters or more, with an uppercase letter, a lowercase letter, a digit
# and a special character — the same rule as every account.
ATEM_ADMIN_PASSWORD=
# ATEM_ADMIN_NAME=Admin

# The database password, with compose — required there too. Letters and digits
# only: it goes into a connection URL, where “@”, “/” or “:” would break it.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Compose deployment ───────────────────────────────────────────────────────

# The release to run — a version such as 0.1.0. Default: the latest release.
# ATEM_VERSION=

# The port the application answers on, on the host. Put a reverse proxy with
# HTTPS in front of it: outside localhost the session cookie requires HTTPS.
# ATEM_PUBLIC_PORT=8080

# The database's port on the host — bound to 127.0.0.1 only, for backups and
# inspection from the machine itself.
# ATEM_DB_PORT=55432

# ── Tuning ───────────────────────────────────────────────────────────────────

# Authentication attempt ceilings, per address: sign-ups per hour, sign-ins per
# fifteen minutes. The defaults (5 and 10) target home use. A shop signing up
# twenty players on a tournament evening, all behind the same address, needs to
# loosen them.
ATEM_REGISTER_ATTEMPTS_MAX=5
ATEM_LOGIN_ATTEMPTS_MAX=10

# The proxies whose X-Forwarded-For may be believed — addresses or CIDR ranges,
# comma-separated. compose.yaml sets the bundled nginx's range (10.89.42.0/24);
# if another reverse proxy sits in front, add its address after it, or every
# request looks like it comes from that proxy and the whole instance shares one
# rate-limit bucket. Leave it empty when nothing sits in front: the header is
# then ignored, which keeps a stranger from forging an address per request.
# The API prints what it understood at startup — “trusted proxies: none” there
# means the header is being ignored.
ATEM_TRUSTED_PROXIES=10.89.42.0/24

# Free space always left on the media disk, in bytes (default 200 MB). Below it,
# no new card image is downloaded, so PostgreSQL never runs out of room first.
ATEM_DISK_RESERVE_BYTES=209715200

# PostgreSQL connection pool size.
ATEM_DB_POOL=10

# ── Development only (compose sets these itself) ─────────────────────────────

# The database. Without it, the server refuses to start rather than serve badly.
DATABASE_URL=postgres://atem:atem@localhost:55432/atem

# The listening interface and port. 127.0.0.1 by default: an instance is never
# exposed to the network unless someone decided so.
ATEM_HOST=127.0.0.1
ATEM_PORT=3000

# Where card images are stored once downloaded. Default: data/media at the
# repository root. Keep it on persistent storage — every lost image is pulled
# again from YGOPRODeck, which blacklists repeated pulls.
# ATEM_MEDIA_DIR=
