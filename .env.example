# La base. Absente, le serveur refuse de démarrer plutôt que de servir mal.
DATABASE_URL=postgres://atem:atem@localhost:5432/atem

# La clé de signature des jetons. Aucune valeur de repli n'existe :
#   openssl rand -base64 32
JWT_SECRET=

# L'interface et le port d'écoute. 127.0.0.1 par défaut : une instance
# n'est jamais exposée au réseau sans qu'on l'ait décidé.
ATEM_HOST=127.0.0.1
ATEM_PORT=3000

# Taille du pool de connexions PostgreSQL.
ATEM_DB_POOL=10

# Les plafonds de tentatives d'authentification, par heure et par adresse.
# Les valeurs par défaut (5 inscriptions, 10 connexions) visent un usage
# domestique. Une boutique qui inscrit vingt joueurs le soir d'un tournoi,
# tous derrière la même adresse, a besoin de les desserrer.
# ATEM_REGISTER_ATTEMPTS_MAX=5
# ATEM_LOGIN_ATTEMPTS_MAX=10
