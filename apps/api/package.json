{
  "name": "@atem/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "../../scripts/api-tests.sh",
    "catalogue:sync": "tsx src/modules/referential/sync.ts",
    "ocr:build-dict": "tsx scripts/build-set-dict.mts"
  },
  "dependencies": {
    "@atem/shared": "workspace:*",
    "@hono/node-server": "^1.19.17",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
