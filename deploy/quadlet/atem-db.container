[Unit]
Description=ATEM — PostgreSQL

[Container]
ContainerName=atem-db
Image=docker.io/library/postgres:16-alpine
Network=atem.network
Volume=atem-pg.volume:/var/lib/postgresql/data
EnvironmentFile=%h/services/atem/.env
Environment=POSTGRES_USER=atem
Environment=POSTGRES_DB=atem
# No NoNewPrivileges here, unlike the services below. On an AppArmor host —
# Debian, Ubuntu — it blocks the container's AppArmor profile transition, so
# its processes keep the launcher's stacked label and the policy forbids them
# to signal each other. The image drops from root to postgres with gosu, which
# signals its child and waits: the container stays up, PostgreSQL never starts,
# and nothing is logged. Found on a Debian 13 instance, 2026-09-23.
DropCapability=ALL
AddCapability=CHOWN
AddCapability=DAC_OVERRIDE
AddCapability=FOWNER
AddCapability=SETGID
AddCapability=SETUID
HealthCmd=pg_isready -U atem -d atem
HealthInterval=3s
HealthRetries=20

[Service]
Restart=always

[Install]
WantedBy=default.target
