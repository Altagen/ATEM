[Unit]
Description=ATEM — schema migration
Requires=atem-db.service
After=atem-db.service

[Container]
ContainerName=atem-migrate
Image=ghcr.io/altagen/atem-api:latest
Network=atem.network
EnvironmentFile=%h/services/atem/.env
# systemd orders "after", not "ready": the migration retries while PostgreSQL
# finishes starting, rather than failing the boot on a race.
Exec=sh -c 'for i in $(seq 30); do node dist/db/migrate.js && exit 0; sleep 2; done; exit 1'
NoNewPrivileges=true
DropCapability=ALL

[Service]
Type=oneshot
RemainAfterExit=yes

[Install]
WantedBy=default.target
