# The static front, served by nginx.
#
# The build stage runs on the builder's own platform: its output is static
# files, the same for every architecture, and only nginx is taken per
# architecture (amd64, arm64).
FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm --filter @atem/web build

FROM docker.io/library/nginx:1.27-alpine AS runtime
LABEL org.opencontainers.image.title="ATEM web" \
      org.opencontainers.image.source="https://github.com/Altagen/ATEM" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
